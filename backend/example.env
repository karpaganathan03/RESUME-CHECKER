# Copy to backend/.env for local development.
# On Vercel, set these in the project's Environment Variables instead.
#
# This file is an EXAMPLE and is tracked by git. Real values belong in
# backend/.env (untracked) or in the Vercel dashboard - never here.

# --- Basics ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database (required) --------------------------------------------------
# MongoDB Atlas connection string. The database name goes before the "?".
# Build it from the Mongo user you created in Atlas; the username and password
# are the ones you set on that database user, not your Atlas login.
#
# MONGODB_USERNAME / MONGODB_PASSWORD are separate variables only so you can see
# where each part goes. The URI is what the app actually reads, so if you set the
# URI, you do not need the other two.
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_db_username:your_db_password@cluster0.xxxxx.mongodb.net/resume-parser?retryWrites=true&w=majority

# --- CORS (optional) ------------------------------------------------------
# Leave this EMPTY for the normal single-project deploy. The frontend and the
# API are one Vercel project, so the browser calls the API on its own origin and
# no CORS applies.
#
# Only set it if something on a DIFFERENT origin calls this API - a separate
# site, a mobile app, or a Vercel preview URL. Comma-separated, no trailing
# slash: "https://app.com/" never matches the Origin header the browser sends.
CLIENT_ORIGINS=

# --- AI (optional) --------------------------------------------------------
# Optional. Empty is a fully working app: every resume is scored by the built-in
# keyword rules, which is also what every test uses. Set it and labd reviews the
# resume against the JD as well, adding its score, its skill list and a written
# verdict - with any failure falling back to the keyword score rather than
# breaking the request.
#
# This is a SERVER-side secret. It is never sent to the browser and must never be
# a VITE_ variable, because Vite inlines those into the JS bundle.
LABD_API_KEY=
