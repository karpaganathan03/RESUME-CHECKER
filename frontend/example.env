# Copy to frontend/.env.local (or set in Vercel project Environment Variables).
#
# When deploying Frontend and Backend SEPARATELY:
# Set VITE_API_URL to the URL of your deployed backend API (e.g. on Vercel, Render, Railway).
# Example:
# VITE_API_URL=https://your-backend-project.vercel.app
#
# During local development:
# Leave VITE_API_URL empty. Vite will proxy /api requests to http://localhost:5000 automatically.
VITE_API_URL=
